{
  "name": "@playhex/pixi-board",
  "version": "1.0.0",
  "description": "Hex board game renderer built on PixiJS",
  "license": "AGPL-3.0-only",
  "author": "Julien Maulny",
  "homepage": "https://playhex.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/playhex/playhex.git",
    "directory": "src/packages/pixi-board"
  },
  "keywords": [
    "hex",
    "board-game",
    "pixi",
    "pixijs"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.ts",
    "./conditional-moves": "./conditional-moves.ts",
    "./shading-patterns": "./shading-patterns.ts"
  },
  "files": [
    "dist/*.js",
    "dist/assets",
    "dist/types",
    "THEMING.md"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:visual-test": "vite build --config vite.visual.config.ts",
    "test:visual": "pnpm run build:visual-test && cypress run --browser chrome",
    "test:visual:update": "pnpm run build:visual-test && cypress run --browser chrome --env UPDATE_SNAPSHOTS=true",
    "test:unit": "NODE_OPTIONS='--import=./register.js' TS_NODE_PROJECT='./tsconfig.json' mocha 'test/**/*.ts' 'resize-observer-debounced/test/**/*.ts' --extension ts --ignore 'test/visual/**'",
    "test": "pnpm run test:unit && pnpm run test:visual",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@playhex/move-notation": "workspace:^"
  },
  "peerDependencies": {
    "@playhex/conditional-moves": "workspace:^",
    "@playhex/shading-patterns": "workspace:^",
    "pixi.js": ">=8",
    "tiny-typed-emitter": ">=2"
  },
  "peerDependenciesMeta": {
    "@playhex/conditional-moves": {
      "optional": true
    },
    "@playhex/shading-patterns": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playhex/conditional-moves": "workspace:^",
    "@playhex/shading-patterns": "workspace:^",
    "@types/node": "26.6.2",
    "@types/pngjs": "*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cypress": "^16.1.0",
    "mocha": "^12.0.2",
    "pixelmatch": "*",
    "pixi.js": "^8.21.0",
    "pngjs": "*",
    "tiny-typed-emitter": "^2.1.0",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./conditional-moves": {
        "types": "./dist/types/conditional-moves.d.ts",
        "default": "./dist/conditional-moves.js"
      },
      "./shading-patterns": {
        "types": "./dist/types/shading-patterns.d.ts",
        "default": "./dist/shading-patterns.js"
      }
    }
  }
}

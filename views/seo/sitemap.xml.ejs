<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <% for (const url of urls) { -%>
        <url><loc><%= baseUrl %><%= url.path %></loc><% if (url.lastmod) { %><lastmod><%= url.lastmod.toISOString() %></lastmod><% } %></url>
    <% } %>
</urlset>
